---
/**
 * The six home-page feature tiles (plan §3.2 item 3). Each tile can link to its group
 * on /features when `linked` is true.
 */
import Icon from '../ui/Icon.astro';
import { FEATURE_TILES } from './content';

interface Props {
  /** Make each tile title link to /features#<id>. Default true. */
  linked?: boolean;
}
const { linked = true } = Astro.props;
---
<ul class="tiles" role="list">
  {FEATURE_TILES.map((t) => (
    <li class="tile">
      <span class="tile__icon"><Icon name={t.icon} size={22} strokeWidth={2} /></span>
      <h3 class="tile__title">
        {linked ? <a href={`/features#${t.id}`}>{t.title}</a> : t.title}
      </h3>
      <p class="tile__body">{t.body}</p>
      {t.note && <p class="tile__note"><Icon name="info" size={15} strokeWidth={2.2} />{t.note}</p>}
    </li>
  ))}
</ul>

<style>
  .tiles {
    display: grid;
    gap: 16px;
    margin: 0;
  }

  @media (min-width: 640px) {
    .tiles {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (min-width: 1024px) {
    .tiles {
      grid-template-columns: repeat(3, minmax(0, 1fr));
      gap: 20px;
    }
  }

  .tile {
    position: relative;
    display: grid;
    align-content: start;
    gap: 10px;
    padding: 24px;
    border-radius: var(--radius-card);
    background: var(--card-bg);
    border: var(--stroke-1) solid transparent;
    transition: border-color var(--dur-instant) var(--ease-out);
  }

  :global([data-theme^="hc-"]) .tile {
    border-color: var(--embed-stroke);
  }

  .tile:has(a:hover) {
    border-color: var(--border-prominent);
  }

  .tile__icon {
    width: 44px;
    height: 44px;
    border-radius: 12px;
    display: grid;
    place-items: center;
    color: var(--link);
    background: color-mix(in srgb, var(--accent) 14%, transparent);
    margin-bottom: 6px;
  }

  .tile__title {
    font-size: 1.3125rem;
    line-height: 1.2;
    font-weight: 700;
  }

  .tile__title a {
    color: var(--text-primary);
    text-decoration: none;
  }

  /* The whole tile is the hit area; the title stays the only link in the tab order. */
  .tile__title a::after {
    content: "";
    position: absolute;
    inset: 0;
    border-radius: inherit;
  }

  .tile__title a:focus-visible {
    outline: none;
  }

  .tile:has(a:focus-visible) {
    outline: 2px solid var(--focus-ring);
    outline-offset: 2px;
  }

  .tile__body {
    color: var(--text-muted);
    font-size: 16px;
    line-height: 1.5;
  }

  .tile__note {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    margin-top: 2px;
    font-size: 14px;
    line-height: 18px;
    font-weight: 600;
    color: var(--text-primary);
  }

  .tile__note :global(.icon) {
    color: var(--link);
  }

  @media (forced-colors: active) {
    .tile {
      border: 1px solid CanvasText;
    }
    .tile:has(a:focus-visible) {
      outline-color: Highlight;
    }
  }
</style>
