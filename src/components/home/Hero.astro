---
/**
 * Home hero: what Catbird is, in one line, where it is today, and an index of the
 * interactions the page shows (wide screens only; on phones the first one follows
 * directly). Kept short so the product starts in the first screen.
 *
 * Availability comes from config (AVAILABILITY / PRIMARY_CTA): while Catbird is in
 * development the page invites people to follow updates, not to install anything, and
 * makes no App Store or beta claim. No price is stated anywhere until one is decided.
 *
 * Props:
 *   highlights  The promoted interactions in page order: { id, eyebrow, title, icon }.
 */
import Button from '../ui/Button.astro';
import Badge from '../ui/Badge.astro';
import Icon from '../ui/Icon.astro';
import { AVAILABILITY, PRIMARY_CTA, MIN_IOS } from '../../config';

interface Highlight {
  id: string;
  eyebrow: string;
  title: string;
  icon: string;
}
interface Props {
  highlights: readonly Highlight[];
}
const { highlights } = Astro.props;

const statusBadge =
  AVAILABILITY === 'in-development' ? 'In development' : AVAILABILITY === 'beta' ? 'Beta' : null;
const statusText =
  AVAILABILITY === 'app-store'
    ? `On the App Store · iPhone and iPad · iOS ${MIN_IOS} or later`
    : `Not on the App Store yet · iPhone and iPad · iOS ${MIN_IOS} or later`;
---
<section class="hero" aria-labelledby="hero-title">
  <div class="hero__inner">
    <div class="hero__copy">
      <img
        class="hero__icon"
        src="/images/app-icon-128.png"
        srcset="/images/app-icon-128.png 1x, /images/app-icon-256.png 2x"
        width="64"
        height="64"
        alt=""
        decoding="async"
      />

      <h1 id="hero-title" class="hero__title">A Bluesky app for iPhone and&nbsp;iPad</h1>

      <p class="hero__lead">
        Catbird uses the Bluesky account you already have. Below are three things it does its own
        way, each shown next to what it explains.
      </p>

      <p class="hero__status">
        {statusBadge && <Badge tone="accent" icon="hammer">{statusBadge}</Badge>}
        <span>{statusText}</span>
      </p>

      <div class="hero__actions">
        <Button href={PRIMARY_CTA.href} size="lg" iconEnd={PRIMARY_CTA.external ? 'arrow-up-right' : undefined}>
          {PRIMARY_CTA.label}
        </Button>
        <Button href="/features" variant="secondary" size="lg" iconEnd="arrow-right">See All Features</Button>
      </div>
    </div>

    <nav class="hero__index" aria-label="On this page">
      <ol class="hero__index-list" role="list">
        {highlights.map((h, i) => (
          <li>
            <a class="hero__index-link" href={`#${h.id}`}>
              <span class="hero__index-icon"><Icon name={h.icon} size={22} /></span>
              <span class="hero__index-text">
                <span class="hero__index-eyebrow">{i + 1}. {h.eyebrow}</span>
                <span class="hero__index-title">{h.title}</span>
              </span>
              <Icon name="arrow-down" size={18} class="hero__index-arrow" />
            </a>
          </li>
        ))}
      </ol>
    </nav>
  </div>
</section>

<style>
  .hero {
    padding: 40px var(--gutter) 24px;
  }

  .hero__inner {
    max-width: var(--content-max);
    margin-inline: auto;
    display: grid;
    gap: 40px;
    align-items: center;
  }

  .hero__copy {
    display: grid;
    justify-items: start;
    gap: 16px;
  }

  .hero__icon {
    width: 64px;
    height: 64px;
    border-radius: 14px;
  }

  .hero__title {
    font-size: clamp(2.5rem, 1.7rem + 3vw, 3.75rem);
    line-height: 1.02;
    font-weight: 800;
    letter-spacing: -0.025em;
    max-width: 16ch;
  }

  .hero__lead {
    font-size: 1.1875rem;
    line-height: 1.45;
    color: var(--text-muted);
    max-width: 40ch;
  }

  .hero__status {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 8px 12px;
    font-size: 15px;
    line-height: 20px;
    color: var(--text-muted);
  }

  .hero__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 12px 16px;
    margin-top: 4px;
  }

  /* The index is a wide-screen aid; on phones the first interaction follows directly. */
  .hero__index {
    display: none;
  }

  .hero__index-list {
    display: grid;
    gap: 12px;
    margin: 0;
  }

  .hero__index-link {
    display: flex;
    align-items: center;
    gap: 16px;
    padding: 18px 20px;
    border-radius: var(--radius-card);
    background: var(--card-bg);
    color: var(--text-primary);
    text-decoration: none;
    transition: background-color var(--dur-instant) var(--ease-out);
  }

  .hero__index-link:hover {
    background: color-mix(in srgb, var(--accent) 10%, var(--card-bg));
  }

  :global([data-theme^="hc-"]) .hero__index-link {
    border: var(--stroke-1) solid var(--embed-stroke);
  }

  .hero__index-icon {
    flex: none;
    width: 44px;
    height: 44px;
    border-radius: 12px;
    display: grid;
    place-items: center;
    color: var(--link);
    background: color-mix(in srgb, var(--accent) 14%, transparent);
  }

  .hero__index-text {
    display: grid;
    gap: 2px;
    flex: 1;
    min-width: 0;
  }

  .hero__index-eyebrow {
    font-size: 13px;
    line-height: 16px;
    font-weight: 600;
    color: var(--text-muted);
  }

  .hero__index-title {
    font-size: 18px;
    line-height: 1.3;
    font-weight: 600;
  }

  .hero__index-link :global(.hero__index-arrow) {
    flex: none;
    color: var(--text-muted);
  }

  @media (min-width: 768px) {
    .hero {
      padding: 56px 32px 32px;
    }
  }

  @media (min-width: 1024px) {
    .hero__inner {
      grid-template-columns: minmax(0, 1.1fr) minmax(0, 0.9fr);
      gap: 64px;
    }
    .hero__index {
      display: block;
    }
  }

  @media (forced-colors: active) {
    .hero__index-link {
      border: 1px solid CanvasText;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .hero__index-link {
      transition: none;
    }
  }
</style>
