 *
 * Grounded in docs/execution-plans/2026-10-02-catbird-website-plan.md §4.2 and the
 * research report. Undecided details (identity, jurisdiction, contact email, effective
 * date) come from src/config.ts and render as "to be completed" markers. No in-app
 * purchase section: whether purchases ship in 1.0 is unknown (see
 * website/docs/legal-open-questions.md).
 */
import LegalLayout from '../components/legal/LegalLayout.astro';
import Pending from '../components/legal/Pending.astro';
import { termsContactEmail, type TocEntry } from '../components/legal/legal';
import { LEGAL, GITHUB_URL, BLUESKY_URL, BLUESKY_HANDLE } from '../config';

const email = termsContactEmail;

const toc: TocEntry[] = [
  { id: 'acceptance', label: 'Accepting these terms' },
  { id: 'bluesky', label: 'Catbird and Bluesky' },
  { id: 'acceptable-use', label: 'Acceptable use' },
  { id: 'reporting', label: 'Reporting and blocking' },
  { id: 'services', label: 'Catbird’s services' },
  { id: 'ask-catbird', label: 'Ask Catbird and AI features' },
  { id: 'license', label: 'Open-source license' },
  { id: 'disclaimers', label: 'Disclaimers' },
  { id: 'liability', label: 'Limitation of liability' },
  { id: 'termination', label: 'Ending your use' },
  { id: 'governing-law', label: 'Governing law' },
  { id: 'changes', label: 'Changes to these terms' },
  { id: 'contact', label: 'Contact' },
];

const BSKY_TOS = 'https://bsky.social/about/support/tos';
const BSKY_GUIDELINES = 'https://bsky.social/about/support/community-guidelines';

const MIT_TEXT = `MIT License

