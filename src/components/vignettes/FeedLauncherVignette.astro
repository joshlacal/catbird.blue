---
/**
 * TEMPORARY ILLUSTRATION of the feeds drawer in Catbird on iPhone, drawn from the release
 * source (build 6, 7c7b1742) until a release-build capture replaces it. Verified layout
 * (docs/homepage-evidence.md):
 *   - App/ContentView.swift:461-523: Close (xmark) at top trailing; bottom bar with
 *     Profile, Bookmarks and My Lists
 *   - Features/Feed/Views/FeedsStartPage.swift:
 *       banner (108pt at phone width), then an identity row: 64pt avatar, name, handle
 *       "Feeds" title row with three glass circles: Add Feed (+), list/grid toggle, Edit
 *       the default feed as a large card, checkmark when selected
 *       "Pinned" (pin.fill) and "Saved" (bookmark.fill) headers, headline, secondary
 *       grid: 3 columns at 402pt (min tile width 88), icons 12pt corners with the name
 *       underneath; a feed with no avatar gets the accent gradient + white first letter
 *       bottom bar search: "Search your feeds"
 *   No paging (removed in 7d103557).
 * Feed names, the person and the handle are fictional (.test is a reserved domain).
 */
import PhoneFrame from '../ui/PhoneFrame.astro';
import Icon from '../ui/Icon.astro';
import './vignette.css';

type Theme = 'light' | 'dim' | 'black' | 'hc-light' | 'hc-dark' | 'cvd-light' | 'cvd-dark';
interface Props {
  theme?: Theme;
  width?: number;
  height?: number;
  class?: string;
}
const { theme, width, height = 640, class: className } = Astro.props;

// Feeds with their own avatar are drawn as a tinted glyph tile (standing in for the
// feed's picture); feeds without one use the app's letter placeholder.
const pinned = [
  { name: 'Science', glyph: 'flask-conical', tone: 'twilight' },
  { name: 'Gardening', glyph: 'sprout', tone: 'aurora' },
  { name: 'Mutuals', letter: 'M' },
];
const saved = [
  { name: 'Birds', glyph: 'bird', tone: 'midnight' },
  { name: 'Art', glyph: 'palette', tone: 'dusk' },
  { name: 'Quiet Posters', letter: 'Q' },
  { name: 'Books', glyph: 'book-open', tone: 'sunrise' },
  { name: 'Local News', letter: 'L' },
  { name: 'Photography', glyph: 'camera', tone: 'lavender' },
];
---
<PhoneFrame
  label="Illustration of the feeds drawer in Catbird on iPhone: your banner and name at the top, a Feeds heading with Add, layout and Edit buttons, your default feed with a checkmark, then your pinned and saved feeds as a grid of icons, and a bottom bar with feed search, Profile, Bookmarks and My Lists."
  theme={theme}
  width={width}
  class={className}
  bleed
>
  <div class="vg fl" style={`--vg-h:${height}px`}>
    <div class="fl__banner">
      <span class="fl__close"><Icon name="x" size={18} strokeWidth={2.4} /></span>
    </div>
    <div class="fl__who">
      <span class="fl__avatar" aria-hidden="true"></span>
      <span class="fl__names">
        <span class="fl__name">Riley Park</span>
        <span class="fl__handle">@riley.test</span>
      </span>
    </div>

    <div class="fl__body">
      <div class="fl__title-row">
        <span class="fl__title">Feeds</span>
        <span class="fl__circle"><Icon name="plus" size={17} strokeWidth={2.4} /></span>
        <span class="fl__circle"><Icon name="list" size={17} strokeWidth={2.4} /></span>
        <span class="fl__circle"><Icon name="pencil" size={16} strokeWidth={2.4} /></span>
      </div>

      <div class="fl__default">
        <span class="fl__default-icon"><Icon name="house" size={22} strokeWidth={2.2} /></span>
        <span class="fl__default-name">Timeline</span>
        <span class="fl__check"><Icon name="check" size={18} strokeWidth={2.6} /></span>
      </div>

      <div class="fl__section"><Icon name="pin" size={15} strokeWidth={2.4} /> Pinned</div>
      <ul class="fl__grid" role="list">
        {pinned.map((f) => (
          <li class="fl__tile">
            {f.letter ? (
              <span class="fl__icon fl__icon--letter">{f.letter}</span>
            ) : (
              <span class="fl__icon" data-tone={f.tone}><Icon name={f.glyph} size={30} strokeWidth={2} /></span>
            )}
            <span class="fl__label">{f.name}</span>
          </li>
        ))}
      </ul>

      <div class="fl__section"><Icon name="bookmark" size={15} strokeWidth={2.4} /> Saved</div>
      <ul class="fl__grid" role="list">
        {saved.map((f) => (
          <li class="fl__tile">
            {f.letter ? (
              <span class="fl__icon fl__icon--letter">{f.letter}</span>
            ) : (
              <span class="fl__icon" data-tone={f.tone}><Icon name={f.glyph} size={30} strokeWidth={2} /></span>
            )}
            <span class="fl__label">{f.name}</span>
          </li>
        ))}
      </ul>
    </div>

    <div class="fl__bottom">
      <span class="fl__search"><Icon name="search" size={16} strokeWidth={2.4} /> Search your feeds</span>
      <span class="fl__tools">
        <Icon name="user" size={19} strokeWidth={2.2} />
        <Icon name="bookmark" size={19} strokeWidth={2.2} />
        <Icon name="list" size={19} strokeWidth={2.2} />
      </span>
    </div>
  </div>
</PhoneFrame>

<style>
  .fl {
    background: var(--bg);
  }

  .fl__banner {
    position: relative;
    height: 108px;
    background: linear-gradient(135deg, var(--accent-midnight), var(--accent));
  }

  .fl__close {
    position: absolute;
    top: 44px;
    right: 14px;
    width: 36px;
    height: 36px;
    border-radius: 50%;
    display: grid;
    place-items: center;
    color: var(--text-primary);
    background: var(--glass-bg, var(--bg-secondary));
    box-shadow: inset 0 0 0 0.5px var(--border-prominent);
  }

  .fl__who {
    display: flex;
    align-items: center;
    gap: 12px;
    padding: 12px 18px 6px;
  }

  .fl__avatar {
    flex: none;
    width: 52px;
    height: 52px;
    border-radius: 50%;
    background: linear-gradient(135deg, color-mix(in srgb, var(--accent-aurora) 80%, #fff), var(--accent-aurora));
  }

  .fl__names {
    display: grid;
    line-height: 1.25;
    min-width: 0;
  }

  .fl__name {
    font-weight: 700;
    font-size: 17px;
  }

  .fl__handle {
    color: var(--text-muted);
    font-size: 14px;
  }

  .fl__body {
    padding: 4px 18px 0;
  }

  .fl__title-row {
    display: flex;
    align-items: center;
    gap: 10px;
    padding: 6px 0 10px;
  }

  .fl__title {
    flex: 1;
    font-family: var(--font-display);
    font-stretch: 120%;
    font-weight: 700;
    font-size: 26px;
    line-height: 1.1;
  }

  .fl__circle {
    flex: none;
    width: 36px;
    height: 36px;
    border-radius: 50%;
    display: grid;
    place-items: center;
    color: var(--link);
    background: var(--glass-bg, var(--bg-secondary));
    box-shadow: inset 0 0 0 0.5px var(--border-prominent);
  }

  .fl__default {
    display: flex;
    align-items: center;
    gap: 12px;
    padding: 12px;
    border-radius: 24px;
    background: color-mix(in srgb, var(--accent) 10%, var(--bg-secondary));
    box-shadow: inset 0 0 0 1px color-mix(in srgb, var(--accent) 45%, transparent);
  }

  .fl__default-icon {
    width: 44px;
    height: 44px;
    border-radius: 12px;
    display: grid;
    place-items: center;
    color: #fff;
    background: linear-gradient(135deg, color-mix(in srgb, var(--accent) 70%, transparent), color-mix(in srgb, var(--accent) 50%, transparent)), var(--accent-midnight);
  }

  .fl__default-name {
    flex: 1;
    font-weight: 600;
    font-size: 17px;
  }

  .fl__check {
    color: var(--link);
    display: inline-flex;
  }

  .fl__section {
    display: flex;
    align-items: center;
    gap: 6px;
    padding: 15px 0 9px;
    font-weight: 600;
    font-size: 17px;
    color: var(--text-muted);
  }

  .fl__grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 12px;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .fl__tile {
    display: grid;
    justify-items: center;
    gap: 6px;
    min-width: 0;
  }

  .fl__icon {
    width: min(80%, 84px);
    aspect-ratio: 1;
    border-radius: 12px;
    display: grid;
    place-items: center;
    color: #fff;
    --tone: var(--accent);
    background: linear-gradient(135deg, color-mix(in srgb, var(--tone) 70%, #fff), var(--tone));
  }

  .fl__icon[data-tone="twilight"] { --tone: var(--accent-twilight); }
  .fl__icon[data-tone="aurora"] { --tone: var(--accent-aurora); }
  .fl__icon[data-tone="midnight"] { --tone: var(--accent-midnight); }
  .fl__icon[data-tone="dusk"] { --tone: var(--accent-dusk); }
  .fl__icon[data-tone="sunrise"] { --tone: var(--accent-sunrise); }
  .fl__icon[data-tone="lavender"] { --tone: var(--accent-lavender); }

  /* The app's placeholder for a feed with no avatar: accent gradient, white first letter. */
  .fl__icon--letter {
    background: linear-gradient(135deg, color-mix(in srgb, var(--accent) 70%, transparent), color-mix(in srgb, var(--accent) 50%, transparent)), var(--accent-midnight);
    font-weight: 600;
    font-size: 22px;
  }

  .fl__label {
    max-width: 100%;
    font-size: 13px;
    line-height: 16px;
    text-align: center;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  /* Bottom bar floats over the grid, which fades out under it like the app's scroll edge. */
  .fl__bottom {
    position: absolute;
    inset: auto 0 0 0;
    display: flex;
    align-items: center;
    gap: 10px;
    padding: 28px 14px 14px;
    background: linear-gradient(to bottom, transparent, color-mix(in srgb, var(--bg) 92%, transparent) 40%, var(--bg));
  }

  .fl__search,
  .fl__tools {
    display: inline-flex;
    align-items: center;
    height: 44px;
    border-radius: 22px;
    background: var(--glass-bg, var(--bg-secondary));
    box-shadow: inset 0 0 0 0.5px var(--border-prominent), var(--shadow-glass-fallback);
  }

  .fl__search {
    flex: 1;
    min-width: 0;
    gap: 8px;
    padding: 0 14px;
    font-size: 14px;
    color: var(--text-muted);
    white-space: nowrap;
    overflow: hidden;
  }

  .fl__tools {
    gap: 16px;
    padding: 0 14px;
    color: var(--link);
  }
</style>
