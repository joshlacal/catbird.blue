---
/**
 * Home (plan §3.2, sections 1-6 and 8). Section 7, "Coming later", is intentionally
 * omitted: it may only appear once decision D1 approves it.
 */
import BaseLayout from '../layouts/BaseLayout.astro';
import Section from '../components/ui/Section.astro';
import Button from '../components/ui/Button.astro';
import Icon from '../components/ui/Icon.astro';
import Hero from '../components/home/Hero.astro';
import FeatureTiles from '../components/home/FeatureTiles.astro';
import ComposerVignette from '../components/vignettes/ComposerVignette.astro';
import ThreadVignette from '../components/vignettes/ThreadVignette.astro';
import AppearanceVignette from '../components/vignettes/AppearanceVignette.astro';
import { ALSO_INCLUDED } from '../components/home/content';
import { TESTFLIGHT_URL, MIN_IOS, APP_STORE_LIVE, APP_STORE_URL } from '../config';

const ctaHref = APP_STORE_LIVE ? APP_STORE_URL : TESTFLIGHT_URL;
const ctaLabel = APP_STORE_LIVE ? 'Get Catbird' : 'Join the Beta';
---
<BaseLayout
  title="Catbird: a Bluesky client for iPhone and iPad"
  description="Catbird is a free, open-source Bluesky app for iPhone and iPad, built natively in SwiftUI. Join the beta on TestFlight."
  path="/"
>
  <Hero />

  <!-- 2. A look inside (illustrations until real screenshots exist, plan §5.5) -->
  <Section tone="secondary" space="lg" labelledby="inside-title" class="inside">
    <div class="section-head">
      <h2 id="inside-title">A look inside</h2>
      <p class="lead">Catbird uses the system font, Apple’s own controls and, on iOS&nbsp;26, Liquid Glass.</p>
    </div>

    <div class="inside__scroller" role="region" aria-label="Illustrations of the app" tabindex="0">
      <ul class="inside__list" role="list">
        <li class="inside__item">
          <ComposerVignette width={320} height={560} />
          <h3 class="inside__title">Write</h3>
          <p class="inside__text">Photos, video, GIFs and alt text, with a ring that tracks the 300-character limit.</p>
        </li>
        <li class="inside__item">
          <ThreadVignette width={320} height={560} />
          <h3 class="inside__title">Read</h3>
          <p class="inside__text">Follow a conversation down the thread line, and translate replies in other languages.</p>
        </li>
        <li class="inside__item">
          <AppearanceVignette width={320} height={560} />
          <h3 class="inside__title">Adjust</h3>
          <p class="inside__text">Dim or True Black, seven accent colors, and type that suits your eyes.</p>
        </li>
      </ul>
    </div>
    <p class="fine inside__note">Illustrations of Catbird’s interface.</p>
  </Section>

  <!-- 3 + 4. Feature tiles and the "also included" list -->
  <Section space="lg" labelledby="features-title">
    <div class="section-head section-head--split">
      <div>
        <h2 id="features-title">What you can do in Catbird</h2>
      </div>
      <Button href="/features" variant="plain" iconEnd="arrow-right">See All Features</Button>
    </div>

    <FeatureTiles />

    <div class="included">
      <h3 class="included__title">Also included</h3>
      <ul class="included__list" role="list">
        {ALSO_INCLUDED.map((item) => (
          <li class="included__item">
            <Icon name={item.icon} size={20} />
            <span>{item.label}</span>
          </li>
        ))}
      </ul>
    </div>
  </Section>

  <!-- 5. How Catbird handles your account (plan §3.2 item 5, facts from §4) -->
  <Section tone="secondary" space="lg" labelledby="account-title" class="account">
    <div class="account__grid">
      <div class="account__head">
        <h2 id="account-title">How Catbird handles your account</h2>
        <p class="lead">What happens to your account when you use Catbird, in three sentences.</p>
        <Button href="/privacy" variant="secondary" iconEnd="arrow-right">Read the Privacy Policy</Button>
      </div>
      <ol class="account__list" role="list">
        <li class="account__item">
          <span class="account__icon"><Icon name="key-round" size={22} /></span>
          <p>You sign in through your Bluesky server in your browser, so Catbird never sees your password.</p>
        </li>
        <li class="account__item">
          <span class="account__icon"><Icon name="server" size={22} /></span>
          <p>Catbird’s own server keeps your sign-in session and relays most of your account’s requests to your Bluesky server.</p>
        </li>
        <li class="account__item">
          <span class="account__icon"><Icon name="activity" size={22} /></span>
          <p>Crash and performance reports go to Sentry, a crash-reporting service.</p>
        </li>
      </ol>
    </div>
  </Section>

  <!-- 6. What is Bluesky? (text only; no Bluesky artwork) -->
  <Section space="lg" width="reading" labelledby="bluesky-title" class="bluesky">
    <h2 id="bluesky-title">What is Bluesky?</h2>
    <div class="bluesky__body">
      <p>
        Bluesky is a social network built on the AT Protocol, an open standard for social apps. Your
        account isn’t tied to one app: you can use it in the official Bluesky app, in Catbird, or in
        both. If you don’t have an account yet, you can create one when you first open Catbird.
      </p>
      <p>
        Catbird is an independent app. It isn’t made by Bluesky Social, PBC, and isn’t affiliated with
        it.
      </p>
      <p>
        <a href="https://bsky.social" rel="noopener">Learn about Bluesky at bsky.social</a>
      </p>
    </div>
  </Section>

  <!-- 8. Closing call to action -->
  <Section space="lg" class="closing" labelledby="closing-title">
    <div class="closing__card">
      <img
        class="closing__icon"
        src="/images/app-icon-128.png"
        srcset="/images/app-icon-128.png 1x, /images/app-icon-256.png 2x"
        width="80"
        height="80"
        alt=""
        loading="lazy"
        decoding="async"
      />
      <h2 id="closing-title">Try Catbird on your iPhone or iPad</h2>
      <p class="lead">
        {APP_STORE_LIVE
          ? `Download it free from the App Store. You need iOS ${MIN_IOS} or later.`
          : `Join the beta through Apple’s TestFlight app. You need iOS ${MIN_IOS} or later.`}
      </p>
      <div class="cluster closing__actions">
        <Button href={ctaHref} size="lg" iconEnd="arrow-up-right">{ctaLabel}</Button>
        <Button href="/features" variant="secondary" size="lg">See All Features</Button>
      </div>
    </div>
  </Section>
</BaseLayout>

<style>
  .section-head {
    display: grid;
    gap: 12px;
    max-width: 640px;
    margin-bottom: 40px;
  }

  .section-head--split {
    max-width: none;
    grid-template-columns: 1fr;
    align-items: end;
  }

  .section-head--split > div {
    display: grid;
    gap: 12px;
    max-width: 640px;
  }

  .section-head--split :global(.btn) {
    justify-self: start;
    padding-inline: 0;
  }

  @media (min-width: 768px) {
    .section-head--split {
      grid-template-columns: 1fr auto;
    }
  }

  /* ---- A look inside ---- */
  .inside__scroller {
    margin-inline: calc(var(--gutter) * -1);
    padding: 8px var(--gutter) 24px;
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    scroll-padding-inline: var(--gutter);
    overscroll-behavior-x: contain;
    border-radius: 0;
  }

  .inside__scroller:focus-visible {
    outline-offset: -2px;
  }

  .inside__list {
    display: grid;
    grid-auto-flow: column;
    grid-auto-columns: min(300px, 82vw);
    gap: 20px;
    margin: 0;
  }

  .inside__item {
    scroll-snap-align: start;
    display: grid;
    /* minmax(0, 1fr) lets the phone frame shrink to the column instead of growing to
       its content's min-content width and spilling into the next card. */
    grid-template-columns: minmax(0, 1fr);
    align-content: start;
    gap: 8px;
  }

  .inside__item :global(.phone-frame) {
    margin-bottom: 12px;
  }

  .inside__title {
    font-size: 1.3125rem;
    line-height: 1.2;
  }

  .inside__text {
    color: var(--text-muted);
    font-size: 16px;
    line-height: 1.5;
    max-width: 32ch;
  }

  .inside__note {
    margin-top: 8px;
  }

  @media (min-width: 1024px) {
    .inside__scroller {
      margin-inline: 0;
      padding-inline: 0;
      overflow: visible;
    }
    .inside__list {
      grid-auto-flow: row;
      grid-template-columns: repeat(3, minmax(0, 1fr));
      grid-auto-columns: auto;
      gap: 40px;
    }
  }

  /* ---- Also included ---- */
  .included {
    margin-top: 56px;
    padding-top: 32px;
    border-top: var(--stroke-1) solid var(--separator);
  }

  .included__title {
    margin-bottom: 20px;
  }

  .included__list {
    display: grid;
    gap: 14px 32px;
    margin: 0;
  }

  @media (min-width: 640px) {
    .included__list {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (min-width: 1024px) {
    .included__list {
      grid-template-columns: repeat(4, minmax(0, 1fr));
    }
  }

  .included__item {
    display: flex;
    align-items: flex-start;
    gap: 10px;
    font-size: 16px;
    line-height: 22px;
  }

  .included__item :global(.icon) {
    flex: none;
    color: var(--link);
    margin-top: 1px;
  }

  /* ---- Account ---- */
  .account__grid {
    display: grid;
    gap: 32px;
  }

  .account__head {
    display: grid;
    justify-items: start;
    align-content: start;
    gap: 16px;
  }

  .account__head :global(.btn) {
    margin-top: 8px;
  }

  .account__list {
    display: grid;
    gap: 12px;
    margin: 0;
  }

  .account__item {
    display: flex;
    gap: 16px;
    align-items: flex-start;
    padding: 20px;
    border-radius: var(--radius-card);
    background: var(--bg);
    font-size: 17px;
    line-height: 1.5;
  }

  :global([data-theme="black"]) .account__item {
    background: var(--elevated-popover);
  }

  :global([data-theme^="hc-"]) .account__item {
    border: var(--stroke-1) solid var(--embed-stroke);
  }

  .account__icon {
    flex: none;
    width: 40px;
    height: 40px;
    border-radius: 50%;
    display: grid;
    place-items: center;
    color: var(--link);
    background: color-mix(in srgb, var(--accent) 14%, transparent);
  }

  .account__item p {
    padding-top: 7px;
  }

  @media (min-width: 1024px) {
    .account__grid {
      grid-template-columns: minmax(0, 0.9fr) minmax(0, 1.1fr);
      gap: 64px;
    }
  }

  /* ---- What is Bluesky? ---- */
  .bluesky__body {
    margin-top: 16px;
    display: grid;
    gap: 16px;
    font-size: 18px;
    line-height: 1.55;
  }

  /* ---- Closing CTA ---- */
  /* Follows another plain section, so it takes no top padding of its own: one gap, not two. */
  :global(.section.closing) {
    padding-top: 0;
  }

  .closing__card {
    display: grid;
    justify-items: center;
    text-align: center;
    gap: 16px;
    padding: 48px 24px;
    border-radius: 32px;
    background: var(--card-bg);
  }

  :global([data-theme^="hc-"]) .closing__card {
    border: var(--stroke-1) solid var(--embed-stroke);
  }

  .closing__icon {
    width: 80px;
    height: 80px;
    border-radius: 18px;
    margin-bottom: 4px;
  }

  .closing__card .lead {
    max-width: 36ch;
  }

  .closing__actions {
    justify-content: center;
    margin-top: 8px;
  }

  @media (min-width: 768px) {
    .closing__card {
      padding: 72px 48px;
    }
  }

  @media (forced-colors: active) {
    .account__item,
    .closing__card {
      border: 1px solid CanvasText;
    }
  }
</style>
