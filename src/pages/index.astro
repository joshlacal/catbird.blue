---
/**
 * Home. Built around three interactions a Bluesky user can see in Catbird, each with its
 * copy beside the picture that shows it. Everything else Catbird does lives on /features.
 *
 * Promoted interactions and their evidence (release build 6, source 7c7b1742; see
 * docs/homepage-evidence.md in this repo):
 *   1. Feeds drawer grid         HomeView.swift, SideDrawer.swift, FeedsStartPage.swift
 *   2. Composer reply chip/ring  ComposerChipsStrip.swift, CharacterLimitIndicator.swift
 *   3. Native iPad app           build-6 archive Info.plist (UIDeviceFamily [1, 2])
 * Blocked-reply cards were the provisional second pick and were replaced: no runtime
 * evidence, "View this post" likely fails against Bluesky's AppView, and list-block
 * Unblock fails silently (docs/homepage-evidence.md).
 * The pictures are temporary illustrations drawn from that source until release-build
 * captures replace them (shot list: docs/homepage-shot-list.md).
 */
import BaseLayout from '../layouts/BaseLayout.astro';
import Section from '../components/ui/Section.astro';
import Button from '../components/ui/Button.astro';
import Icon from '../components/ui/Icon.astro';
import Hero from '../components/home/Hero.astro';
import Interaction from '../components/home/Interaction.astro';
import FeedLauncherVignette from '../components/vignettes/FeedLauncherVignette.astro';
import ComposerQuietVignette from '../components/vignettes/ComposerQuietVignette.astro';
import IPadVignette from '../components/vignettes/IPadVignette.astro';
import { AVAILABILITY, PRIMARY_CTA, BLUESKY_HANDLE, MIN_IOS } from '../config';

/** The promoted interactions, in page order. The hero's index and the sections share it. */
const HIGHLIGHTS = [
  { id: 'feeds', eyebrow: 'Feeds', title: 'Your pinned and saved feeds, in one grid', icon: 'layout-grid' },
  { id: 'composer', eyebrow: 'Writing', title: 'See who can reply before you post', icon: 'pen-line' },
  { id: 'ipad', eyebrow: 'iPad', title: 'Also on iPad', icon: 'tablet' },
] as const;
const [feeds, composer, ipad] = HIGHLIGHTS;
---
<BaseLayout
  title="Catbird: explore Bluesky through your feeds"
  description="Catbird is a Bluesky app in development for iPhone and iPad. Keep your pinned and saved feeds in one grid, and write posts and threads with reply settings spelled out."
  path="/"
>
  <Hero highlights={HIGHLIGHTS} />

  <Section space="md" class="interactions" labelledby="interactions-title">
    <h2 id="interactions-title" class="visually-hidden">Feeds and writing in Catbird</h2>

    <Interaction id={feeds.id} eyebrow={feeds.eyebrow} title={feeds.title}>
      <FeedLauncherVignette slot="media" width={340} height={600} />
      <p>
        Tap the grid button on Home to see your feeds together: your default feed at the top,
        then the feeds you’ve pinned and the ones you’ve saved, as a grid of icons. Tap any one
        to switch to it.
      </p>
      <p class="interaction__why">Every feed you’ve pinned or saved is in one place.</p>
    </Interaction>

    <Interaction id={composer.id} eyebrow={composer.eyebrow} title={composer.title} reverse>
      <ComposerQuietVignette slot="media" width={340} height={540} />
      <p>
        If you limit who can reply, the composer spells it out above the keyboard, for example
        “Mentioned, Following · No quotes”.
      </p>
      <p>
        The character count stays a small grey ring until you’re within 50 characters of the
        300-character limit.
      </p>
    </Interaction>

    <Interaction id={ipad.id} eyebrow={ipad.eyebrow} title={ipad.title} wide>
      <IPadVignette slot="media" width={760} />
      <p>Catbird runs on iPad as well as iPhone and fills the iPad screen.</p>
      <p class="interaction__how">iPadOS&nbsp;{MIN_IOS} or later.</p>
    </Interaction>
  </Section>

  <!-- The rest of Catbird lives on /features; one line here, no catalogue. -->
  <Section space="sm" class="rest" labelledby="rest-title">
    <div class="rest__card">
      <div class="rest__text">
        <h2 id="rest-title" class="rest__title">And the rest of Bluesky</h2>
        <p>
          Posting with photos, video and alt text, threads, search, notifications, lists,
          moderation tools and direct messages are all here too.
        </p>
      </div>
      <Button href="/features" variant="secondary" iconEnd="arrow-right">See All Features</Button>
    </div>
  </Section>

  <!-- How sign-in and data work, condensed from /privacy (draft). Facts, not claims. -->
  <Section space="md" class="account" labelledby="account-title">
    <div class="account__grid">
      <h2 id="account-title" class="account__title">Signing in</h2>
      <ul class="account__list" role="list">
        <li><Icon name="key-round" size={20} /><span>You sign in with your Bluesky account in your browser, so Catbird never sees your password.</span></li>
        <li><Icon name="server" size={20} /><span>Catbird’s server keeps your sign-in session and passes your requests on to your Bluesky server.</span></li>
        <li><Icon name="activity" size={20} /><span>Crash and performance reports go to Sentry, a crash-reporting service.</span></li>
      </ul>
      <p class="account__more"><a href="/privacy">How Catbird handles your data</a> (draft privacy policy)</p>
    </div>
  </Section>

  <!-- Where Catbird is today. -->
  <Section space="lg" class="closing" labelledby="closing-title">
    <div class="closing__card">
      <img
        class="closing__icon"
        src="/images/app-icon-128.png"
        srcset="/images/app-icon-128.png 1x, /images/app-icon-256.png 2x"
        width="64"
        height="64"
        alt=""
        loading="lazy"
        decoding="async"
      />
      {AVAILABILITY === 'in-development' ? (
        <>
          <h2 id="closing-title">Catbird is in development</h2>
          <p class="lead">
            It isn’t on the App Store yet. Follow @{BLUESKY_HANDLE} on Bluesky to hear when you
            can try it.
          </p>
        </>
      ) : (
        <>
          <h2 id="closing-title">Try Catbird on your iPhone or iPad</h2>
          <p class="lead">You need iOS {MIN_IOS} or later.</p>
        </>
      )}
      <div class="cluster closing__actions">
        <Button href={PRIMARY_CTA.href} size="lg" iconEnd={PRIMARY_CTA.external ? 'arrow-up-right' : undefined}>{PRIMARY_CTA.label}</Button>
        <Button href="/support" variant="secondary" size="lg">Support</Button>
      </div>
    </div>
  </Section>
</BaseLayout>

<style>
  /* ---- Interactions ---- */
  /* Phones: the first interaction starts close under the hero. (Section's root doesn't
     carry this page's style scope, hence :global with the section class.) */
  @media (max-width: 767.98px) {
    :global(.section.interactions) {
      padding-top: 24px;
    }
  }

  /* ---- The rest ---- */
  .rest__card {
    display: grid;
    gap: 20px;
    align-items: center;
    padding: 28px;
    border-radius: var(--radius-card);
    background: var(--card-bg);
  }

  :global([data-theme^="hc-"]) .rest__card {
    border: var(--stroke-1) solid var(--embed-stroke);
  }

  .rest__text {
    display: grid;
    gap: 8px;
    max-width: 60ch;
    font-size: 17px;
    line-height: 1.5;
  }

  .rest__title {
    font-size: 1.375rem;
    line-height: 1.2;
  }

  .rest__card :global(.btn) {
    justify-self: start;
  }

  @media (min-width: 768px) {
    .rest__card {
      grid-template-columns: 1fr auto;
      padding: 32px 40px;
    }
  }

  /* ---- Signing in ---- */
  .account__grid {
    display: grid;
    gap: 20px;
    padding-top: 32px;
    border-top: var(--stroke-1) solid var(--separator);
  }

  .account__title {
    font-size: 1.375rem;
    line-height: 1.2;
  }

  .account__list {
    display: grid;
    gap: 14px;
    margin: 0;
    font-size: 17px;
    line-height: 1.5;
  }

  .account__list li {
    display: flex;
    gap: 12px;
    align-items: flex-start;
  }

  .account__list :global(.icon) {
    flex: none;
    margin-top: 2px;
    color: var(--link);
  }

  .account__more {
    font-size: 15px;
    color: var(--text-muted);
  }

  @media (min-width: 900px) {
    .account__grid {
      grid-template-columns: minmax(0, 0.6fr) minmax(0, 1.4fr);
      column-gap: 64px;
    }
    .account__more {
      grid-column: 2;
    }
  }

  /* ---- Closing ---- */
  .closing__card {
    display: grid;
    justify-items: center;
    text-align: center;
    gap: 16px;
    padding: 48px 24px;
    border-radius: 32px;
    background: var(--card-bg);
  }

  :global([data-theme^="hc-"]) .closing__card {
    border: var(--stroke-1) solid var(--embed-stroke);
  }

  .closing__icon {
    width: 64px;
    height: 64px;
    border-radius: 14px;
  }

  .closing__card .lead {
    max-width: 40ch;
  }

  .closing__actions {
    justify-content: center;
    margin-top: 8px;
  }

  @media (min-width: 768px) {
    .closing__card {
      padding: 64px 48px;
    }
  }

  @media (forced-colors: active) {
    .rest__card,
    .closing__card {
      border: 1px solid CanvasText;
    }
  }
</style>
