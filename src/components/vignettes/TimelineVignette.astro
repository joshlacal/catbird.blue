---
/**
 * Illustration of the Home timeline on iPhone: large "Timeline" title, a reposted post,
 * a post with a link card, the Feeds and New Post floating buttons, and the iOS 26
 * tab bar (Home, Notifications, Messages, plus the separate Search button).
 * People, handles and text are fictional; handles use the reserved .test domain.
 *
 * Props:
 *   theme   Optional fixed theme for the frame. Default: follows the page.
 *   width   Optional frame max width.
 *   height  Screen content height in px. Default 660.
 *   class   Extra classes for the frame.
 */
import PhoneFrame from '../ui/PhoneFrame.astro';
import Icon from '../ui/Icon.astro';
import './vignette.css';

type Theme = 'light' | 'dim' | 'black' | 'hc-light' | 'hc-dark' | 'cvd-light' | 'cvd-dark';
interface Props {
  theme?: Theme;
  width?: number;
  height?: number;
  class?: string;
}
const { theme, width, height = 640, class: className } = Astro.props;
---
<PhoneFrame
  label="Illustration of the Catbird timeline on iPhone: two posts with reply, repost, like and share buttons, a link preview, floating Feeds and New Post buttons, and the tab bar."
  theme={theme}
  width={width}
  class={className}
>
  <div class="vg" style={`--vg-h:${height}px`}>
    <div class="vg__large-title t-nav-large-title">Timeline</div>

    <div class="cb-repost-hdr"><Icon name="repeat-2" size={14} strokeWidth={2.4} /> Reposted by Noor Haddad</div>
    <div class="cb-post">
      <div class="cb-post__col">
        <span class="cb-avatar" style="width:var(--avatar-lg);height:var(--avatar-lg)" data-tone="aurora"></span>
      </div>
      <div class="cb-post__body">
        <div class="cb-header">
          <span class="cb-header__name">June Vale</span>
          <span class="cb-header__meta">@june.test · 2h</span>
          <span class="cb-header__more"><Icon name="ellipsis" size={18} /></span>
        </div>
        <p class="cb-text">First frost on the allotment this morning. The kale doesn’t seem to mind at all.</p>
        <div class="cb-actions">
          <span class="cb-action"><Icon name="message-circle" /><span class="cb-count">4</span></span>
          <span class="cb-action is-reposted"><Icon name="repeat-2" strokeWidth={2.8} /><span class="cb-count">7</span></span>
          <span class="cb-action is-liked"><svg class="icon" viewBox="0 0 24 24" aria-hidden="true" fill="currentColor"><path d="M12 20.5S3.5 15.4 3.5 9.4A4.4 4.4 0 0 1 12 7.1a4.4 4.4 0 0 1 8.5 2.3c0 6-8.5 11.1-8.5 11.1z"/></svg><span class="cb-count">52</span></span>
          <span class="cb-action"><Icon name="share" /></span>
        </div>
      </div>
    </div>

    <div class="cb-post">
      <div class="cb-post__col">
        <span class="cb-avatar" style="width:var(--avatar-lg);height:var(--avatar-lg)" data-tone="twilight"></span>
      </div>
      <div class="cb-post__body">
        <div class="cb-header">
          <span class="cb-header__name">Tomás Ruiz<svg class="cb-badge" viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="12" r="10"/><path d="M7.5 12.3l3 3 6-6.3" fill="none" stroke="#fff" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"/></svg></span>
          <span class="cb-header__meta">@tomas.test · 3h</span>
          <span class="cb-header__more"><Icon name="ellipsis" size={18} /></span>
        </div>
        <p class="cb-text">Wrote up the reservoir loop with the two best benches marked.</p>
        <div class="cb-link-card">
          <div class="cb-link-card__media"></div>
          <div class="cb-link-card__body">
            <p class="cb-link-card__title">The reservoir loop, bench by bench</p>
            <p class="cb-link-card__desc">Fourteen kilometres, one hill, and where to stop for the view.</p>
            <div class="cb-link-card__host">trails.example</div>
          </div>
        </div>
        <div class="cb-actions">
          <span class="cb-action"><Icon name="message-circle" /><span class="cb-count">11</span></span>
          <span class="cb-action"><Icon name="repeat-2" /><span class="cb-count">23</span></span>
          <span class="cb-action"><Icon name="heart" /><span class="cb-count">140</span></span>
          <span class="cb-action"><Icon name="share" /></span>
        </div>
      </div>
    </div>

    <div class="vg__bottom">
      <div class="cb-fabs">
        <span class="cb-fab cb-glass--regular"><Icon name="grid-3x3" size={26} strokeWidth={1.8} /></span>
        <span class="cb-fab cb-glass"><Icon name="pencil" size={26} strokeWidth={1.8} /></span>
      </div>
      <div class="cb-tabbar-wrap">
        <div class="cb-tabbar cb-glass--regular">
          <span class="cb-tab is-selected"><Icon name="house" size={24} strokeWidth={1.8} />Home</span>
          <span class="cb-tab"><Icon name="bell" size={24} strokeWidth={1.8} />Notifications</span>
          <span class="cb-tab"><Icon name="mail" size={24} strokeWidth={1.8} />Messages</span>
        </div>
        <span class="cb-tab-search cb-glass--regular"><Icon name="search" size={22} strokeWidth={2} /></span>
      </div>
    </div>
  </div>
</PhoneFrame>
