---
/**
 * One promoted interaction on the home page: a picture of the app beside the copy that
 * explains it.
 *
 * Layout:
 *   - Narrow screens: heading, then the picture, then the explanation, so the picture
 *     arrives early and the copy stays directly against it.
 *   - Wide screens (900px+): the picture in one column, and the heading and explanation
 *     in the other, meeting at the picture's vertical middle. `reverse` swaps the sides.
 *
 * Props:
 *   id            Section id (anchor) and heading id prefix.
 *   eyebrow       Short area label ("Feeds").
 *   title         The heading (sentence case).
 *   reverse       Put the picture on the right on wide screens. Default false.
 *   illustration  The picture is a temporary illustration, not a capture from the app.
 *                 Adds a visible note so no one mistakes it for a screenshot. Default true.
 *   wide          Picture column is wider (for the iPad picture). Default false.
 * Slots:
 *   media         The picture (a vignette or a captured screenshot/video).
 *   default       The copy: paragraphs. Use <p class="interaction__why"> for the benefit
 *                 line and <p class="interaction__how"> for where to find it.
 */
interface Props {
  id: string;
  eyebrow: string;
  title: string;
  reverse?: boolean;
  illustration?: boolean;
  wide?: boolean;
}
const { id, eyebrow, title, reverse = false, illustration = true, wide = false } = Astro.props;
---
<section
  id={id}
  class:list={['interaction', reverse && 'interaction--reverse', wide && 'interaction--wide']}
  aria-labelledby={`${id}-title`}
>
  <div class="interaction__head">
    <p class="eyebrow">{eyebrow}</p>
    <h2 id={`${id}-title`} class="interaction__title">{title}</h2>
  </div>
  <div class="interaction__media">
    <slot name="media" />
    {illustration && (
      <p class="interaction__note">Illustration. A screenshot from the app will replace it.</p>
    )}
  </div>
  <div class="interaction__body">
    <slot />
  </div>
</section>

<style>
  .interaction {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    grid-template-areas:
      "head"
      "media"
      "body";
    gap: 20px;
  }

  /* Space between consecutive interactions. Kept here (both elements carry this
     component's style scope) rather than on the page's Section wrapper. */
  .interaction + .interaction {
    margin-top: 72px;
  }

  .interaction__head {
    grid-area: head;
    display: grid;
    gap: 12px;
    max-width: 34rem;
  }

  .interaction__title {
    font-size: clamp(1.75rem, 1.3rem + 1.6vw, 2.5rem);
    line-height: 1.08;
    letter-spacing: -0.015em;
  }

  .interaction__body {
    grid-area: body;
    display: grid;
    align-content: start;
    gap: 14px;
    max-width: 34rem;
    font-size: 18px;
    line-height: 1.55;
  }

  .interaction__body :global(.interaction__why) {
    padding-top: 14px;
    border-top: var(--stroke-1) solid var(--separator);
    font-weight: 500;
  }

  .interaction__body :global(.interaction__how) {
    font-size: 15px;
    line-height: 1.45;
    color: var(--text-muted);
  }

  .interaction__media {
    grid-area: media;
    display: grid;
    justify-items: center;
    gap: 12px;
    min-width: 0;
  }

  .interaction__note {
    font-size: 13px;
    line-height: 18px;
    color: var(--text-muted);
    text-align: center;
  }

  @media (min-width: 900px) {
    /* Equal flexible rows above and below the copy centre the heading and explanation
       on the picture as one block, as before the narrow-screen reorder. */
    .interaction {
      grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
      grid-template-rows: 1fr auto auto 1fr;
      grid-template-areas:
        "media ."
        "media head"
        "media body"
        "media .";
      column-gap: 64px;
      row-gap: 0;
    }
    .interaction--reverse {
      grid-template-areas:
        ". media"
        "head media"
        "body media"
        ". media";
    }
    .interaction--wide {
      grid-template-columns: minmax(0, 1.2fr) minmax(0, 0.8fr);
    }
    .interaction--reverse.interaction--wide {
      grid-template-columns: minmax(0, 0.8fr) minmax(0, 1.2fr);
    }
    .interaction__head {
      padding-bottom: 14px;
    }
    .interaction__media {
      align-self: center;
    }
    .interaction + .interaction {
      margin-top: 128px;
    }
  }
</style>
